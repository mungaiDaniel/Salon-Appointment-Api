# Copy to .env and fill in. Never commit the real .env file.

# --- Required -------------------------------------------------------------
# At least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- App ------------------------------------------------------------------
# config.DevelopmentConfig | config.ProductionConfig
FLASK_CONFIG=config.DevelopmentConfig
FLASK_APP=main.py

# Defaults to a local SQLite file in development. Required in production, e.g.
#   postgresql://salon_user:<password>@localhost:5432/salon_db
DATABASE_URI=

# Comma-separated list of browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000

# Optional: use a different key for JWTs (defaults to SECRET_KEY)
# JWT_SECRET_KEY=
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7

# Optional rate limits (Flask-Limiter syntax) and storage (use redis:// for multi-worker)
# RATELIMIT_LOGIN=10 per minute
# RATELIMIT_REGISTER=20 per hour
# RATELIMIT_STORAGE_URI=memory://

# --- docker compose only ----------------------------------------------------
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=
POSTGRES_DB=salon_db
